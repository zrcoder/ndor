func branch(size, ratio, angle float64, iterations int) {
    color "black"
    // 枝长兼作线宽，越细的枝越细
    width size
    pen "down"
    step size
    pen "up"

    if iterations > 0 {
        left angle
        branch size*ratio, ratio, angle, iterations-1

        right angle*2
        branch size*ratio, ratio, angle, iterations-1

        left angle
    }

    step -size
}

branch 12, 0.7, 30, 5
