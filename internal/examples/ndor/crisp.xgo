// crisp

const (
    half  = 500
    minor = 10
    major = 100
)

const (
    first = -half + minor
    top   = -half + major
)

func row(y int) {
    f := float64(y)
    from -half, f
    to half, f
}

func col(x int) {
    f := float64(x)
    from f, -half
    to f, half
}

linew 1

for x <- first:half:minor {
    col x
}
for y <- first:half:minor {
    row y
}
color 0, 0, 0, 55
stroke

for x <- top:half:major {
    col x
}
for y <- top:half:major {
    row y
}

color 0, 0, 0, 120
stroke
